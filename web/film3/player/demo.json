5.229,"U"],[5.337,"nn"],[5.397,"sil"]],"src":{"b":23,"s":0},"seg":26},{"id":"l17","who":"baba","text":"O yalancı","emo":"neutral","t":117.779,"d":0.84,"audio":null,"visemes":[[0,"sil"],[0.034,"O"],[0.269,"I"],[0.329,"aa"],[0.437,"nn"],[0.496,"aa"],[0.605,"nn"],[0.664,"CH"],[0.724,"I"],[0.832,"sil"]],"src":{"b":24,"s":5},"seg":28}],"cues":[{"t":1.87,"d":6.01,"who":null,"text":"Babam, her sabah dışarıya giderken bir kere ahıra uğrar, öteye beriye bakardı."},{"t":7.88,"d":2.42,"who":null,"text":"Ben o gün gene ahırda yalnızdım."},{"t":10.3,"d":2.86,"who":null,"text":"Hasan evde hizmetçimiz Pervin'le kalmıştı."},{"t":13.16,"d":6.09,"who":null,"text":"Babam çeşmeye bakarken, yalağın içinde kırılmış kaşağıyı gördü; Dadaruh'a haykırdı:"},{"t":19.25,"d":1.04,"who":"baba","text":"Gel buraya!"},{"t":20.28,"d":3.41,"who":null,"text":"Nefesim kesilecekti, bilmem neden, çok korkmuştum."},{"t":23.69,"d":6.08,"who":null,"text":"Dadaruh şaşırdı, kırılmış kaşağı meydana çıkınca, babam bunu kimin yaptığını sordu."},{"t":29.77,"d":0.77,"who":null,"text":"Dadaruh:"},{"t":30.54,"d":0.88,"who":"dadaruh","text":"Bilmiyorum"},{"t":31.42,"d":0.55,"who":null,"text":"dedi."},{"t":31.97,"d":3.69,"who":null,"text":"Babamın gözleri bana döndü, daha bir şey sormadan:"},{"t":35.66,"d":0.52,"who":"agabey","text":"Hasan"},{"t":36.18,"d":0.52,"who":null,"text":"dedim."},{"t":36.69,"d":0.86,"who":"baba","text":"Hasan mı?"},{"t":37.56,"d":3.02,"who":"agabey","text":"Evet, dün Dadaruh uyurken odaya girdi"},{"t":40.57,"d":1.14,"who":"agabey","text":"Sandıktan aldı"},{"t":41.71,"d":2.15,"who":"agabey","text":"Sonra yalağın taşında ezdi"},{"t":43.86,"d":2.36,"who":"baba","text":"Niye Dadaruh'a haber vermedin?"},{"t":46.22,"d":0.97,"who":"agabey","text":"Uyuyordu"},{"t":47.19,"d":1.61,"who":"baba","text":"Çağır şunu bakayım"},{"t":48.8,"d":1.75,"who":null,"text":"Çitin kapısından geçtim."},{"t":50.54,"d":2.35,"who":null,"text":"Gölgeli yoldan eve doğru koştum."},{"t":52.9,"d":1.31,"who":null,"text":"Hasan'ı çağırdım."},{"t":54.2,"d":2.52,"who":null,"text":"Zavallının bir şeyden haberi yoktu."},{"t":56.73,"d":1.71,"who":null,"text":"Koşarak arkamdan geldi."},{"t":58.44,"d":1.2,"who":null,"text":"Babam pek sertti."},{"t":59.64,"d":2.29,"who":null,"text":"Bir bakışından ödümüz kopardı."},{"t":61.93,"d":1.41,"who":null,"text":"Hasan'a dedi ki:"},{"t":63.33,"d":2.6,"who":"baba","text":"Eğer yalan söylersen seni döverim!"},{"t":65.93,"d":0.8,"who":"hasan","text":"Söylemem"},{"t":66.73,"d":2.65,"who":"baba","text":"Pekala, bu kaşağıyı niye kırdın?"},{"t":69.39,"d":4.18,"who":null,"text":"Hasan, Dadaruh'un elinde duran alete şaşkın şaşkın baktı!"},{"t":73.56,"d":2.56,"who":null,"text":"Sonra sarı saçlı başını sarsarak:"},{"t":76.13,"d":0.95,"who":"hasan","text":"Ben kırmadım"},{"t":77.08,"d":0.55,"who":null,"text":"dedi."},{"t":77.63,"d":1.84,"who":"baba","text":"Yalan söyleme, diyorum"},{"t":79.47,"d":1.04,"who":"hasan","text":"Ben kırmadım"},{"t":80.5,"d":1.04,"who":null,"text":"Babam tekrar:"},{"t":81.54,"d":2.15,"who":"baba","text":"Doğru söyle, darılmayacağım"},{"t":83.69,"d":1.32,"who":"baba","text":"Yalan çok fenadır"},{"t":85.01,"d":0.55,"who":null,"text":"dedi."},{"t":85.56,"d":2.21,"who":null,"text":"Hasan, inkârında inat etti."},{"t":87.77,"d":1.31,"who":null,"text":"Babam hiddetlendi."},{"t":89.08,"d":2.53,"who":null,"text":"Üzerine yürüdü,"},{"t":91.61,"d":1.18,"who":"baba","text":"Utanmaz yalancı"},{"t":92.79,"d":2.31,"who":null,"text":"diye yüzüne bir tokat indirdi."},{"t":95.11,"d":5.54,"who":"baba","text":"Götür bunu eve; sakın bunu bir daha buraya sokma"},{"t":100.64,"d":1.55,"who":"baba","text":"Hep Pervin'le otursun!"},{"t":102.19,"d":1.21,"who":null,"text":"diye haykırdı."},{"t":103.4,"d":3.33,"who":null,"text":"Dadaruh, ağlayan kardeşimi kucağına aldı."},{"t":106.73,"d":3.19,"who":null,"text":"Çitin kapısına doğru yürüdü."},{"t":109.92,"d":2.53,"who":null,"text":"Artık ahırda hep yalnız oynuyordum."},{"t":112.45,"d":1.55,"who":null,"text":"Hasan evde mahpustu."},{"t":113.99,"d":2.7,"who":null,"text":"Annem geldikten sonra da affedilmedi."},{"t":116.69,"d":1.09,"who":null,"text":"Fırsat düştükçe,"},{"t":117.78,"d":0.84,"who":"baba","text":"O yalancı"},{"t":118.62,"d":0.89,"who":null,"text":"derdi babam."},{"t":119.51,"d":4.72,"who":null,"text":"Hasan yediği tokat aklına geldikçe ağlamaya başlar, güç susardı."},{"t":124.23,"d":5.28,"who":null,"text":"Zavallı anneciğim benim iftira atabileceğime hiç ihtimal vermiyordu."},{"t":129.5,"d":3.66,"who":null,"text":"Aptal Dadaruh, atlara ezdirmiş olmasın?\" derdi."}],"audio":{"v":1,"src":"audiobook","voice":"Rasalgethi","narrSex":"m","dur":129.56,"aligned":0,"parts":[{"url":null,"sec":63.4},{"url":null,"sec":37.4},{"url":null,"sec":28.76}],"holds":[{"at":89.081,"d":1.1,"t":89.081},{"at":94.007,"d":1.6,"t":95.107},{"at":104.03,"d":0.9,"t":106.73}],"segs":[{"t0":0,"t1":19.245,"w0":0,"w1":33,"who":"narr","kind":"narr"},{"t0":19.245,"t1":20.28,"w0":34,"w1":35,"who":"baba","kind":"say"},{"t0":20.28,"t1":30.539,"w0":36,"w1":53,"who":"narr","kind":"narr"},{"t0":30.539,"t1":31.424,"w0":54,"w1":54,"who":"dadaruh","kind":"say"},{"t0":31.424,"t1":35.659,"w0":55,"w1":63,"who":"narr","kind":"narr"},{"t0":35.659,"t1":36.176,"w0":64,"w1":64,"who":"agabey","kind":"say"},{"t0":36.176,"t1":36.694,"w0":65,"w1":65,"who":"narr","kind":"narr"},{"t0":36.694,"t1":37.558,"w0":66,"w1":67,"who":"baba","kind":"say"},{"t0":37.558,"t1":43.862,"w0":68,"w1":79,"who":"agabey","kind":"say"},{"t0":43.862,"t1":46.218,"w0":80,"w1":83,"who":"baba","kind":"say"},{"t0":46.218,"t1":47.188,"w0":84,"w1":84,"who":"agabey","kind":"say"},{"t0":47.188,"t1":48.798,"w0":85,"w1":87,"who":"baba","kind":"say"},{"t0":48.798,"t1":63.332,"w0":88,"w1":115,"who":"narr","kind":"narr"},{"t0":63.332,"t1":65.93,"w0":116,"w1":120,"who":"baba","kind":"say"},{"t0":65.93,"t1":66.732,"w0":121,"w1":121,"who":"hasan","kind":"say"},{"t0":66.732,"t1":69.385,"w0":122,"w1":126,"who":"baba","kind":"say"},{"t0":69.385,"t1":76.127,"w0":127,"w1":139